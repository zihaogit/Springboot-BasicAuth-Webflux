# Database Configuration
POSTGRES_DB=<your-database-name>
POSTGRES_USER=<your-database-username>
POSTGRES_PASSWORD=<your-database-password>

# Timezone Configuration
APP_TIMEZONE=Asia/Singapore

# JWT Configuration
JWT_SECRET=<your-jwt-secret-at-least-32-chars>

# FusionAuth Settings
FUSIONAUTH_URL=http://localhost:9011
FUSIONAUTH_CLIENT_ID=<your-application-client-id>
FUSIONAUTH_CLIENT_SECRET=<your-oauth-client-secret>
FUSIONAUTH_REDIRECT_URI=http://localhost:8080/auths/social/callback
FUSIONAUTH_API_KEY=<your-fusionauth-api-key>
FUSIONAUTH_IDP_GOOGLE_ID=<your-fusionauth-google-idp-id>
FUSIONAUTH_IDP_FACEBOOK_ID=<your-fusionauth-facebook-idp-id>

# FusionAuth Webhook Security
FUSIONAUTH_WEBHOOK_SECRET=<your-webhook-secret>
FUSIONAUTH_WEBHOOK_SIGNATURE_KEY=<your-webhook-hmac-signature-key>
FUSIONAUTH_WEBHOOK_MAX_AGE_SECONDS=300
FUSIONAUTH_WEBHOOK_RATE_LIMIT_MAX=100
FUSIONAUTH_WEBHOOK_RATE_LIMIT_WINDOW=60

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
