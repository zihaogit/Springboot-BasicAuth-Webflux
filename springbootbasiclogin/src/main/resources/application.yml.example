# ==============================================================================
# Spring Boot Configuration Template (application.yml.example)
# Copy this file to application.yml or supply these variables in your environment/.env
# ==============================================================================

spring:
  profiles:
    active: ${SPRING_PROFILES_ACTIVE:kafka}
  r2dbc:
    username: ${POSTGRES_USER:postgres}
    password: ${POSTGRES_PASSWORD:root}
    url: r2dbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:security_assignment}
  flyway:
    username: ${spring.r2dbc.username}
    password: ${spring.r2dbc.password}
    url: jdbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:security_assignment}
    locations: classpath:db/migration/common,classpath:db/migration/dev
    baseline-on-migrate: true
  data:
    redis:
      repositories:
        enabled: false
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD}
      timeout: 2000ms
  jackson:
    time-zone: ${APP_TIMEZONE:Asia/Singapore}
  main:
    banner-mode: off

app:
  timezone: ${APP_TIMEZONE:Asia/Singapore}
  base-url: ${APP_BASE_URL:http://localhost:8080}
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:8080}
  mail:
    host: ${MAIL_HOST:log}
    port: ${MAIL_PORT:1025}
    properties:
      mail:
        smtp:
          auth: false

logging:
  level:
    root: INFO
    org:
      springframework:
        security: INFO

springdoc:
  swagger-ui:
    path: /swagger-ui.html
    enabled: ${SWAGGER_ENABLED:false}
  api-docs:
    enabled: ${SWAGGER_ENABLED:false}

auth:
  otp-expiry: ${AUTH_OTP_EXPIRY:300s}
  reset-token-expiry: ${AUTH_RESET_TOKEN_EXPIRY:900s}
  mail-config:
    provider: log
    from: noreply@yourdomain.com
    name: XXX Company
  jwt:
    secret: ${JWT_SECRET}
    issuer: springboot-basiclogin
    access-token-ttl: ${JWT_ACCESS_TOKEN_TTL:2h}
    refresh-token-ttl: ${JWT_REFRESH_TOKEN_TTL:24h}
  fusionauth:
    base-url: ${FUSIONAUTH_URL:http://localhost:9011}
    client-id: ${FUSIONAUTH_CLIENT_ID}
    client-secret: ${FUSIONAUTH_CLIENT_SECRET}
    redirect-uri: ${FUSIONAUTH_REDIRECT_URI:http://localhost:8080/auths/social/callback}
    api-key: ${FUSIONAUTH_API_KEY}
    idp-ids:
      google: ${FUSIONAUTH_IDP_GOOGLE_ID}
      facebook: ${FUSIONAUTH_IDP_FACEBOOK_ID}
  webhook:
    secret: ${FUSIONAUTH_WEBHOOK_SECRET}
    signature-key: ${FUSIONAUTH_WEBHOOK_SIGNATURE_KEY}
    max-event-age-seconds: ${FUSIONAUTH_WEBHOOK_MAX_AGE_SECONDS:300}
    rate-limit:
      max-attempts: ${FUSIONAUTH_WEBHOOK_RATE_LIMIT_MAX:100}
      window-seconds: ${FUSIONAUTH_WEBHOOK_RATE_LIMIT_WINDOW:60}

---
# Kafka Profile Configuration (enable via SPRING_PROFILES_ACTIVE=kafka)
spring:
  config:
    activate:
      on-profile: kafka
  kafka:
    bootstrap-servers: ${KAFKA_BOOTSTRAP_SERVERS:localhost:9092}
    consumer:
      group-id: ${KAFKA_CONSUMER_GROUP:bulk-job-group}
      auto-offset-reset: earliest
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      value-deserializer: org.springframework.kafka.support.serializer.JsonDeserializer
      properties:
        spring.json.trusted.packages: "*"
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.springframework.kafka.support.serializer.JsonSerializer

app:
  kafka:
    topics:
      bulk-jobs: ${KAFKA_TOPIC_BULK_JOBS:bulk-jobs}
      bulk-jobs-dlq: ${KAFKA_TOPIC_BULK_JOBS_DLQ:bulk-jobs-dead-letter}
